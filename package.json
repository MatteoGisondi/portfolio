{
  "name": "portfolio",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "init": "node scripts/init.js",
    "predev": "bun run init",
    "dev": "vite",
    "prebuild": "bun run init",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "serve": "bun index.ts",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "vue": "^3.5.45",
    "vue-pdf-embed": "2.1.7",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.11",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/vue-router": "^2.0.0",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/compiler-sfc": "^3.5.45",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "npm-run-all2": "9.0.4",
    "typescript": "^6.0.3",
    "vite": "8.3.8",
    "vue-tsc": "3.3.14"
  }
}
